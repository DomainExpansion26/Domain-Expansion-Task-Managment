# ----------------------------------------------------
# DOMAIN EXPANSION TASK MANAGEMENT - ENVIRONMENT CONFIG
# ----------------------------------------------------

# Database Connection (PostgreSQL for production, SQLite for local dev)
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/domain_expansion_tasks?schema=public"

# Authentication & Session Security
AUTH_SECRET="domain-expansion-super-secure-production-auth-secret-key-32chars"
JWT_SECRET="domain-expansion-super-secure-production-jwt-key-32chars"

# Public Production URLs (Set to your live domain over HTTPS)
NEXT_PUBLIC_APP_URL="https://tasks.domainexpansion.in"
FRONTEND_URL="https://tasks.domainexpansion.in"
BACKEND_URL="https://tasks.domainexpansion.in"
NEXT_PUBLIC_APP_NAME="Domain Expansion"
NEXT_PUBLIC_APP_SLOGAN="Think Outside The Box"

# Resend Transactional Email API (https://resend.com)
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM="Domain Expansion <notifications@domainexpansion.in>"

# AI Provider API Keys (Can also be configured via UI Admin Settings)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Object Storage (S3 or Cloudinary)
STORAGE_API_KEY=""
STORAGE_SECRET=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# Node Environment
NODE_ENV="production"
PORT=3000
